# Performance Guidelines for Angular Development

## Change Detection Optimization

### OnPush Strategy Implementation
```typescript
// ✅ Use OnPush change detection for better performance
@Component({
  selector: 'app-optimized-component',
  templateUrl: './optimized-component.html',
  changeDetection: ChangeDetectionStrategy.OnPush
})
export class OptimizedComponent implements OnInit, OnDestroy {
  @Input() data!: Data[];
  @Output() dataChange = new EventEmitter<Data[]>();

  private readonly destroy$ = new Subject<void>();

  constructor(private dataService: DataService) {}

  ngOnInit(): void {
    this.dataService.getData()
      .pipe(takeUntil(this.destroy$))
      .subscribe(data => {
        // Trigger change detection manually if needed
        this.cdr.detectChanges();
      });
  }

  ngOnDestroy(): void {
    this.destroy$.next();
    this.destroy$.complete();
  }

  // Use immutable updates to trigger change detection
  updateData(newData: Data): void {
    const updatedData = this.data.map(item =>
      item.id === newData.id ? newData : item
    );
    this.dataChange.emit(updatedData);
  }

  // Use trackBy for performance in *ngFor
  trackByFn = (index: number, item: Data): number => item.id;
}
```

### Template Expression Optimization
```html
<!-- ❌ Avoid: Complex calculations in templates -->
<div *ngFor="let item of items">
  {{ complexCalculation(item) }} <!-- Expensive operation -->
</div>

<!-- ✅ Recommended: Use pure pipes -->
<div *ngFor="let item of items">
  {{ item | complexCalculation }}
</div>

<!-- ✅ Or use getter with memoization -->
<div *ngFor="let item of items">
  {{ getCalculatedValue(item) }}
</div>
```

```typescript
// ✅ Pure pipe implementation
@Pipe({
  name: 'complexCalculation',
  pure: true
})
export class ComplexCalculationPipe implements PipeTransform {
  transform(item: any): any {
    // Expensive calculation
    return this.performComplexCalculation(item);
  }

  private performComplexCalculation(item: any): any {
    // Complex logic here
    return result;
  }
}

// ✅ Memoized getter
export class OptimizedComponent {
  private calculationCache = new Map<any, any>();

  getCalculatedValue(item: any): any {
    if (this.calculationCache.has(item.id)) {
      return this.calculationCache.get(item.id);
    }

    const result = this.performComplexCalculation(item);
    this.calculationCache.set(item.id, result);
    return result;
  }
}
```

## Memory Management

### Subscription Management
```typescript
// ✅ Proper subscription management with takeUntil
@Component({
  changeDetection: ChangeDetectionStrategy.OnPush
})
export class MemorySafeComponent implements OnInit, OnDestroy {
  private readonly destroy$ = new Subject<void>();

  ngOnInit(): void {
    // Multiple subscriptions with proper cleanup
    this.dataService.getData()
      .pipe(
        takeUntil(this.destroy$),
        retry(3),
        catchError(error => {
          this.handleError(error);
          return EMPTY;
        })
      )
      .subscribe(data => this.handleData(data));

    this.userService.getUser()
      .pipe(takeUntil(this.destroy$))
      .subscribe(user => this.handleUser(user));
  }

  ngOnDestroy(): void {
    this.destroy$.next();
    this.destroy$.complete();
  }
}

// ✅ Alternative: Use async pipe when possible
@Component({
  template: `
    <div *ngFor="let item of data$ | async; trackBy: trackByFn">
      {{ item.name }}
    </div>
  `
})
export class AsyncComponent {
  data$ = this.dataService.getData();

  trackByFn = (index: number, item: any): number => item.id;
}
```

### Event Listener Cleanup
```typescript
// ✅ Proper event listener cleanup
@Component({
  selector: 'app-event-component'
})
export class EventComponent implements OnInit, OnDestroy {
  private resizeHandler = this.handleResize.bind(this);
  private scrollHandler = this.handleScroll.bind(this);

  ngOnInit(): void {
    window.addEventListener('resize', this.resizeHandler);
    document.addEventListener('scroll', this.scrollHandler);
  }

  ngOnDestroy(): void {
    window.removeEventListener('resize', this.resizeHandler);
    document.removeEventListener('scroll', this.scrollHandler);
  }

  private handleResize(): void {
    // Handle resize
  }

  private handleScroll(): void {
    // Handle scroll
  }
}
```

## Bundle Optimization

### Lazy Loading
```typescript
// ✅ Implement lazy loading for modules
const routes: Routes = [
  {
    path: 'users',
    loadChildren: () => import('./user/user.module').then(m => m.UserModule),
    canActivate: [AuthGuard],
    data: { preload: true }
  },
  {
    path: 'admin',
    loadChildren: () => import('./admin/admin.module').then(m => m.AdminModule),
    canActivate: [AuthGuard, AdminGuard]
  }
];

// ✅ Custom preloading strategy
@Injectable()
export class CustomPreloadingStrategy implements PreloadingStrategy {
  preload(route: Route, load: () => Observable<any>): Observable<any> {
    if (route.data && route.data['preload']) {
      return load();
    }
    return of(null);
  }
}
```

### Standalone Components
```typescript
// ✅ Use standalone components for better tree-shaking
@Component({
