### 7. Material Progress and Loading
```typescript
// ✅ Material progress implementation
@Component({
  selector: 'app-material-progress',
  template: `
    <mat-card>
      <mat-card-header>
        <mat-card-title>Progress Indicators</mat-card-title>
      </mat-card-header>

      <mat-card-content>
        <!-- Linear Progress -->
        <div class="progress-section">
          <h3>Linear Progress</h3>
          <mat-progress-bar mode="determinate" [value]="linearProgress"></mat-progress-bar>
          <p>Progress: {{ linearProgress }}%</p>
        </div>

        <!-- Circular Progress -->
        <div class="progress-section">
          <h3>Circular Progress</h3>
          <mat-progress-spinner mode="determinate" [value]="circularProgress"></mat-progress-spinner>
          <p>Progress: {{ circularProgress }}%</p>
        </div>

        <!-- Indeterminate Progress -->
        <div class="progress-section">
          <h3>Loading...</h3>
          <mat-progress-bar mode="indeterminate"></mat-progress-bar>
        </div>

        <!-- Loading Overlay -->
        <div class="loading-overlay" *ngIf="isLoading">
          <mat-spinner></mat-spinner>
          <p>Loading data...</p>
        </div>
      </mat-card-content>
    </mat-card>
  `,
  styles: [`
    .progress-section {
      margin: 20px 0;
      text-align: center;
    }

    .loading-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 1000;
    }

    .loading-overlay p {
      color: white;
      margin-top: 16px;
    }
  `]
})
export class MaterialProgressComponent {
  linearProgress = 0;
  circularProgress = 0;
  isLoading = false;

  ngOnInit(): void {
    this.simulateProgress();
  }

  simulateProgress(): void {
    const interval = setInterval(() => {
      this.linearProgress += 10;
      this.circularProgress += 10;

      if (this.linearProgress >= 100) {
        clearInterval(interval);
      }
    }, 500);
  }

  showLoading(): void {
    this.isLoading = true;
    setTimeout(() => {
      this.isLoading = false;
    }, 3000);
  }
}
