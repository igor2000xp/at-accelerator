### 5. Material Dialogs
```typescript
// ✅ Material dialog implementation
@Component({
  selector: 'app-confirm-dialog',
  template: `
    <h2 mat-dialog-title>{{ data.title }}</h2>
    <mat-dialog-content>
      <p>{{ data.message }}</p>
    </mat-dialog-content>
    <mat-dialog-actions align="end">
      <button mat-button mat-dialog-close>Cancel</button>
      <button mat-raised-button color="warn" [mat-dialog-close]="true">
        {{ data.confirmText }}
      </button>
    </mat-dialog-actions>
  `
})
export class ConfirmDialogComponent {
  constructor(
    public dialogRef: MatDialogRef<ConfirmDialogComponent>,
    @Inject(MAT_DIALOG_DATA) public data: {
      title: string;
      message: string;
      confirmText: string;
    }
  ) {}
}

// ✅ Dialog service
@Injectable({ providedIn: 'root' })
export class DialogService {
  constructor(private dialog: MatDialog) {}

  confirm(title: string, message: string, confirmText: string = 'Confirm'): Observable<boolean> {
    const dialogRef = this.dialog.open(ConfirmDialogComponent, {
      width: '400px',
      data: { title, message, confirmText },
      disableClose: true
    });

    return dialogRef.afterClosed();
  }

  openFormDialog<T>(component: Type<T>, data?: any, config?: MatDialogConfig): Observable<any> {
    const dialogRef = this.dialog.open(component, {
      width: '600px',
      data,
      disableClose: true,
      ...config
    });

    return dialogRef.afterClosed();
  }
}

// ✅ Usage in component
export class UserManagementComponent {
  constructor(
    private dialogService: DialogService,
    private snackBar: MatSnackBar
  ) {}

  deleteUser(user: User): void {
    this.dialogService.confirm(
      'Delete User',
      `Are you sure you want to delete ${user.name}?`,
      'Delete'
    ).subscribe(result => {
      if (result) {
        // Delete user
        this.snackBar.open('User deleted successfully', 'Close', {
          duration: 3000
        });
      }
    });
  }

  editUser(user: User): void {
    this.dialogService.openFormDialog(UserFormDialogComponent, { user })
      .subscribe(result => {
        if (result) {
          // Update user
          this.snackBar.open('User updated successfully', 'Close', {
            duration: 3000
          });
        }
      });
  }
}
