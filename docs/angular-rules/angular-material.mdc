              formControlName="name"
              placeholder="Enter your full name"
              aria-describedby="name-error"
              [attr.aria-invalid]="form.get('name')?.invalid && form.get('name')?.touched">
            <mat-error id="name-error" *ngIf="form.get('name')?.invalid && form.get('name')?.touched">
              Name is required
            </mat-error>
          </mat-form-field>

          <mat-form-field appearance="outline" class="full-width">
            <mat-label for="email-input">Email Address</mat-label>
            <input
              matInput
              id="email-input"
              type="email"
              formControlName="email"
              placeholder="Enter your email address"
              aria-describedby="email-error"
              [attr.aria-invalid]="form.get('email')?.invalid && form.get('email')?.touched">
            <mat-error id="email-error" *ngIf="form.get('email')?.invalid && form.get('email')?.touched">
              Please enter a valid email address
            </mat-error>
          </mat-form-field>

          <div class="form-actions">
            <button
              mat-button
              type="button"
              (click)="onCancel()"
              aria-label="Cancel form submission">
              Cancel
            </button>
            <button
              mat-raised-button
              color="primary"
              type="submit"
              [disabled]="form.invalid"
              aria-label="Submit form">
              Submit
            </button>
          </div>
        </form>
      </mat-card-content>
    </mat-card>
  `,
  styles: [`
    .full-width {
      width: 100%;
      margin-bottom: 16px;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 16px;
      margin-top: 24px;
    }
  `]
})
export class AccessibleMaterialComponent {
  form = new FormGroup({
    name: new FormControl('', Validators.required),
    email: new FormControl('', [Validators.required, Validators.email])
  });

  onSubmit(): void {
    if (this.form.valid) {
      console.log('Form submitted:', this.form.value);
    }
  }

  onCancel(): void {
    this.form.reset();
  }
}
