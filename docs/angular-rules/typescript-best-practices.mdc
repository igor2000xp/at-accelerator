## Advanced TypeScript Patterns

### Generic Constraints
```typescript
// ✅ Proper generic constraints
interface Identifiable {
  id: number;
}

interface Timestamped {
  createdAt: Date;
  updatedAt?: Date;
}

// Generic service with constraints
@Injectable({ providedIn: 'root' })
export class BaseApiService<T extends Identifiable & Timestamped> {
  constructor(
    protected http: HttpClient,
    protected endpoint: string
  ) {}

  getById(id: number): Observable<T> {
    return this.http.get<T>(`${this.endpoint}/${id}`);
  }

  create(item: Omit<T, 'id' | 'createdAt' | 'updatedAt'>): Observable<T> {
    return this.http.post<T>(this.endpoint, item);
  }

  update(id: number, updates: Partial<Omit<T, 'id' | 'createdAt'>>): Observable<T> {
    return this.http.patch<T>(`${this.endpoint}/${id}`, updates);
  }
}

// Usage
export class UserService extends BaseApiService<User> {
  constructor(http: HttpClient) {
    super(http, '/users');
  }
}
```

### Conditional Types
```typescript
// ✅ Advanced conditional types
type NonNullableFields<T> = {
  [K in keyof T]: T[K] extends null | undefined ? never : K;
}[keyof T];

type RequiredNonNullable<T> = Pick<T, NonNullableFields<T>>;

// Usage in forms
type UserFormFields = RequiredNonNullable<User>;
```

### Template Literal Types
```typescript
// ✅ Template literal types for API endpoints
type HttpMethod = 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE';

type ApiEndpoint<T extends string> = `/api/${T}`;

type UserEndpoints =
  | ApiEndpoint<'users'>
  | ApiEndpoint<'users/:id'>
  | ApiEndpoint<'users/:id/profile'>;

// Usage
const endpoints: Record<UserEndpoints, string> = {
  '/api/users': '/users',
  '/api/users/:id': '/users/:id',
  '/api/users/:id/profile': '/users/:id/profile'
} as const;
```

## Error Handling with TypeScript

### Typed Error Handling
```typescript
// ✅ Typed error handling
interface ApiError {
  code: string;
  message: string;
  details?: Record<string, unknown>;
}

interface ValidationError extends ApiError {
  code: 'VALIDATION_ERROR';
  fieldErrors: Record<string, string[]>;
}

interface NetworkError extends ApiError {
  code: 'NETWORK_ERROR';
  status: number;
}

type AppError = ValidationError | NetworkError | ApiError;

// Error handling service
@Injectable({ providedIn: 'root' })
export class ErrorHandlingService {
  handleError(error: AppError): void {
    switch (error.code) {
      case 'VALIDATION_ERROR':
        this.handleValidationError(error);
        break;
      case 'NETWORK_ERROR':
        this.handleNetworkError(error);
        break;
      default:
        this.handleGenericError(error);
    }
  }

  private handleValidationError(error: ValidationError): void {
    // Handle validation errors
  }

  private handleNetworkError(error: NetworkError): void {
    // Handle network errors
  }

  private handleGenericError(error: ApiError): void {
    // Handle generic errors
  }
}
```

## Testing with TypeScript

### Typed Test Utilities
```typescript
// ✅ Typed test utilities
export function createMockUser(overrides: Partial<User> = {}): User {
  return {
    id: 1,
    name: 'Test User',
    email: 'test@example.com',
    role: 'user',
    createdAt: new Date(),
    ...overrides
  };
}

export function createMockApiResponse<T>(data: T): ApiResponse<T> {
  return {
    data,
    message: 'Success',
    success: true,
    timestamp: new Date()
  };
}

// Usage in tests
describe('UserService', () => {
  let service: UserService;
  let httpMock: HttpTestingController;

  beforeEach(() => {
    TestBed.configureTestingModule({
      imports: [HttpClientTestingModule],
      providers: [UserService]
    });

    service = TestBed.inject(UserService);
    httpMock = TestBed.inject(HttpTestingController);
  });

  it('should get user by id', () => {
    const mockUser = createMockUser({ id: 1 });
    const mockResponse = createMockApiResponse(mockUser);

    service.getUser(1).subscribe(user => {
      expect(user).toEqual(mockUser);
    });

    const req = httpMock.expectOne('/api/users/1');
    expect(req.request.method).toBe('GET');
    req.flush(mockResponse);
  });
});
```

## Performance Considerations

### Type-Safe Performance Patterns
```typescript
// ✅ Type-safe memoization
function memoize<T extends (...args: any[]) => any>(
  fn: T,
  getKey?: (...args: Parameters<T>) => string
): T {
  const cache = new Map<string, ReturnType<T>>();

  return ((...args: Parameters<T>): ReturnType<T> => {
    const key = getKey ? getKey(...args) : JSON.stringify(args);

    if (cache.has(key)) {
      return cache.get(key)!;
    }

    const result = fn(...args);
    cache.set(key, result);
    return result;
  }) as T;
}

// Usage
const expensiveCalculation = memoize((n: number): number => {
  // Expensive calculation
  return n * n;
});
```

### Type-Safe Caching
```typescript
// ✅ Type-safe caching service
@Injectable({ providedIn: 'root' })
export class CacheService {
  private cache = new Map<string, { data: unknown; timestamp: number }>();
  private readonly TTL = 5 * 60 * 1000; // 5 minutes

  set<T>(key: string, data: T): void {
    this.cache.set(key, { data, timestamp: Date.now() });
  }

  get<T>(key: string): T | null {
    const item = this.cache.get(key);

    if (!item) {
      return null;
    }

    if (Date.now() - item.timestamp > this.TTL) {
      this.cache.delete(key);
      return null;
    }

    return item.data as T;
  }

  clear(): void {
    this.cache.clear();
  }
}
```

## Best Practices Summary

### Do's ✅
- Use strict TypeScript configuration
- Prefer interfaces over types for object shapes
- Use utility types appropriately
- Implement proper error handling with typed errors
- Use generic constraints for type safety
- Follow consistent naming conventions
- Use barrel exports for clean imports
- Implement proper testing with typed utilities

### Don'ts ❌
- Use `any` type without justification
- Ignore TypeScript errors with `@ts-ignore`
- Use unconstrained index signatures
- Mix different naming conventions
- Create overly complex type definitions
- Skip type annotations for public APIs
- Use loose typing for critical data structures

This comprehensive guide ensures type-safe, maintainable Angular applications with proper TypeScript usage patterns.
